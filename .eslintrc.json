{
  "extends": [
    "next/core-web-vitals"
  ],
  "rules": {
    // General rules for better code quality
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-expressions": "error",
    "prefer-const": "error",
    "no-var": "error",
    
    // Next.js specific rules
    "@next/next/no-html-link-for-pages": "error",
    "@next/next/no-img-element": "warn"
  },
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  }
}
