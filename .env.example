# Database Configuration
# PostgreSQL connection string for the main database
DATABASE_URL=postgresql://username:password@localhost:5432/solaceassignment

# Alternative PostgreSQL URL (used by some ORM tools)
POSTGRES_URL=postgresql://username:password@localhost:5432/solaceassignment

# Enhanced Database Pool Configuration
# Maximum number of connections in the pool (default: 20)
DB_POOL_MAX=20

# Idle timeout for connections in seconds (default: 30)
DB_IDLE_TIMEOUT=30

# Connection timeout in seconds (default: 30)
DB_CONNECT_TIMEOUT=30

# Query timeout in seconds (default: 60)
DB_QUERY_TIMEOUT=60

# Enable database query debugging in development (default: false)
DB_DEBUG=false

# Redis Configuration (for caching and session management)
# Enable/disable Redis caching (default: true)
REDIS_ENABLED=true

# Redis connection details
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Redis connection pool settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_OFFLINE_QUEUE=false
REDIS_LAZY_CONNECT=true
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# Application Configuration
# Environment: development, staging, production
NODE_ENV=development

# Application URL (used for redirects and API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Performance Monitoring
# Enable performance tracking
ENABLE_PERFORMANCE_TRACKING=true

# Enable bundle analysis (set to 'true' to analyze bundle size)
ANALYZE=false

# Security Configuration
# JWT Secret for session management (when implemented)
JWT_SECRET=your_super_secret_jwt_key_here

# API Keys (when external services are integrated)
# Search service API key (if using external search like Algolia)
SEARCH_API_KEY=your_search_api_key_here

# Analytics and Monitoring
# Application insights or monitoring service keys
MONITORING_API_KEY=your_monitoring_key_here

# Feature Flags
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable search suggestions
ENABLE_SEARCH_SUGGESTIONS=true

# Enable advanced filtering
ENABLE_ADVANCED_FILTERING=true

# Database Pool Configuration
# Maximum number of database connections in the pool
DB_POOL_MAX=20

# Minimum number of database connections in the pool
DB_POOL_MIN=5

# Database connection timeout (in milliseconds)
DB_CONNECTION_TIMEOUT=30000

# Cache Configuration
# Cache TTL in seconds (5 minutes default)
CACHE_TTL=300

# Memory cache size limit
MEMORY_CACHE_SIZE=100

# Logging Configuration
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Email Configuration (for future notifications)
# SMTP server configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# From email address
FROM_EMAIL=noreply@example.com

# File Upload Configuration (for future file handling)
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf